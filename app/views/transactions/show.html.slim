h1 = "#{@transaction.type_label} Transaction"

dl.row
  dt.col-sm-3 UUID
  dd.col-sm-9 = @transaction.uuid

  dt.col-sm-3 Status
  dd.col-sm-9
    span.badge class=@transaction.status_badge_class = @transaction.status

  dt.col-sm-3 Amount
  dd.col-sm-9 = @transaction.formatted_amount

  - if current_user.admin?
    dt.col-sm-3 Merchant
    dd.col-sm-9 = @transaction.merchant.name

  dt.col-sm-3 Customer email
  dd.col-sm-9 = @transaction.customer_email

  dt.col-sm-3 Customer phone
  dd.col-sm-9 = @transaction.customer_phone

  - if @transaction.referenced_uuid
    dt.col-sm-3 References
    dd.col-sm-9 = @transaction.referenced_uuid

  dt.col-sm-3 Created
  dd.col-sm-9 = @transaction.created_at.strftime("%Y-%m-%d %H:%M")

= link_to "Back", transactions_path, class: "btn btn-secondary"
