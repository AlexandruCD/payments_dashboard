.d-flex.justify-content-between.align-items-center.mb-3
  h1 Merchants
  = link_to "New Merchant", new_admin_merchant_path, class: "btn btn-primary"

- if @merchants.empty?
  p.text-muted No merchants yet.
- else
  table.table.table-striped.align-middle
    thead
      tr
        th Name
        th Email
        th Status
        th Transactions
        th

    tbody
      - @merchants.each do |merchant|
        tr
          td = link_to merchant.name, admin_merchant_path(merchant)
          td = merchant.email
          td
            span.badge class=merchant.status_badge_class = merchant.status
          td = merchant.transaction_count
          td.d-flex.gap-2
            = link_to "Edit", edit_admin_merchant_path(merchant), class: "btn btn-sm btn-outline-secondary"
            = button_to "Delete", admin_merchant_path(merchant), method: :delete,
              class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } }
