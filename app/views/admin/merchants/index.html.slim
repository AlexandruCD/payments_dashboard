.d-flex.justify-content-between.align-items-center.mb-3
  h1 = t(".title")
  = link_to t(".new"), new_admin_merchant_path, class: "btn btn-primary"

- if @merchants.empty?
  p.text-muted = t(".empty")
- else
  table.table.table-striped.align-middle
    thead
      tr
        th = t(".name")
        th = t(".email")
        th = t(".status")
        th = t(".transactions")
        th

    tbody
      - @merchants.each do |merchant|
        tr
          td = link_to merchant.name, admin_merchant_path(merchant)
          td = merchant.email
          td
            span.badge class=merchant.status_badge_class = merchant.status_label
          td = merchant.transaction_count
          td.d-flex.gap-2
            = link_to t(".edit"), edit_admin_merchant_path(merchant), class: "btn btn-sm btn-outline-secondary"
            = button_to t(".delete"), admin_merchant_path(merchant), method: :delete,
              class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t(".confirm_delete") } }
