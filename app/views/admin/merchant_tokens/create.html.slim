- content_for :head do
  meta name="turbo-cache-control" content="no-cache"

h1 = t(".title", name: @merchant.name)
p = t(".instructions")

.mb-3
  = label_tag :api_token, t(".token_label"), class: "form-label"
  = text_area_tag :api_token, @issued_token[:token], readonly: true, rows: 5, class: "form-control", autocomplete: "off"
p = t(".expires_at", time: l(@issued_token[:expires_at], format: :token_expiry))

= link_to t(".back"), admin_merchant_path(@merchant), class: "btn btn-secondary"
